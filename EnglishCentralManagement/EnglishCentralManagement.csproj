    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>342f1f77-f692-4549-a81d-11d402ba57af</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
