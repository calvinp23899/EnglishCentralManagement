@model StaffDetailDto

<div class="teacher-form view-only">
    <div class="teacher-form__header">
        <h2>Staff Information</h2>
    </div>

    <div class="teacher-form__grid">

        <div class="form-group">
            <label>Full Name</label>
            <div class="form-value">@Model.FullName</div>
        </div>

        <div class="form-group">
            <label>Date of Birth</label>
            <div class="form-value">@Model.DateOfBirth.ToString("yyyy-MM-dd")</div>
        </div>

        <div class="form-group">
            <label>Phone Number</label>
            <div class="form-value">@Model.PhoneNumber</div>
        </div>

        <div class="form-group">
            <label>Email</label>
            <div class="form-value">@Model.Email</div>
        </div>

        <div class="form-group">
            <label>Status</label>
            <span class="form-value">@Model.Status</span>
        </div>

        <div class="form-group">
            <label>Contract Type</label>
            <div class="form-value">@Model.ContractType</div>
        </div>

        <div class="form-group">
            <label>Working Type</label>
            <div class="form-value">@Model.WorkingType</div>
        </div>

        <div class="form-group">
            <label>Years of Experience</label>
            <div class="form-value">@Model.YearsOfExperience</div>
        </div>

        <div class="form-group">
            <label>Hourly Rate</label>
            <div class="form-value">
                @Model.HourlyRate?.ToString("c0",
                         new System.Globalization.CultureInfo("vi-VN"))
            </div>
        </div>

        <div class="form-group">
            <label>Working Hour</label>
            <div class="form-value">
                @Model.WorkingHour
            </div>
        </div>

        <div class="form-group">
            <label>Salary</label>
            <div class="form-value">
                @Model.MonthlySalary?.ToString("c0",
                         new System.Globalization.CultureInfo("vi-VN"))
            </div>
        </div>

        <div class="form-group">
            <label>Onboarding Date</label>
            <div class="form-value">@Model.OnboardingDate?.ToString("yyyy-MM-dd")</div>
        </div>

        <div class="form-group">
            <label>Created Date</label>
            <div class="form-value">@Model.CreatedDate?.ToString("yyyy-MM-dd")</div>
        </div>

        <div class="form-group">
            <label>Created By</label>
            <div class="form-value">@Model.CreatedBy</div>
        </div>


        <div class="form-group">
            <label>Updated Date</label>
            <div class="form-value">@Model.UpdatedDate?.ToString("yyyy-MM-dd")</div>
        </div>

        <div class="form-group">
            <label>Updated By</label>
            <div class="form-value">@Model.UpdatedBy</div>
        </div>

        <div class="form-group">
            <label>Title</label>
            <div class="form-value">@Model.Title</div>
        </div>

        <div class="form-group full">
            <label>Address</label>
            <div class="form-value">@Model.Address</div>
        </div>

        <div class="form-group full">
            <label>CardNumber</label>
            <div class="form-value">@Model.CardNumber</div>
        </div>
        <div class="form-group full">
            <label>Bank</label>
            <div class="form-value">@Model.Bank</div>
        </div>

        <div class="form-group full">
            <label>Avatar</label>
            <img class="avatar" src="@Model.Image" />
        </div>

    </div>
</div>
