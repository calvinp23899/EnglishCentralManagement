@model PagedResult<StaffDto>
@{
    var isAdmin = User.IsInRole("Admin");
    var isManager = User.IsInRole("Manager");
    var canDelete = isAdmin || isManager;

}
<div class="admin-page admin-teacher">
    <!-- HEADER -->
    <div class="admin-page__header">     
        <h1>Teacher Management</h1>
        <a class="btn-primary" href="@Url.Action("Create", "Teacher", new { area = "Admin" })">
            + New Staff
        </a>
    </div>

    <!-- TOOLBAR -->
    <div class="admin-page__toolbar">
        <form method="get" asp-action="Index" asp-controller="Teacher" asp-area="Admin">
            <input type="text"
                   name="search"
                   value="@ViewBag.teacherSearch"
                   placeholder="Search name,email,phone..." />

            <button type="submit" class="btn-search">Search</button>
        </form>
        @if (canDelete)
        {
            <button type="button" class="btn-primary" onclick="downloadStaffExcel(this)">Download Excel</button>
        }

    </div>
    

    <!-- TABLE -->
    <div class="admin-page__table">
        <table>
            <thead>
                <tr>
                    <th>Full Name</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Gender</th>
                    <th>Role</th>
                    <th>Status</th>
                    <th width="120">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || !Model.Items.Any())
                {
                    <tr>
                        <td colspan="5" style="text-align:center;">
                            No teachers found
                        </td>
                    </tr>
                }else{
                    @foreach (var staff in Model.Items)
                    {
                        <tr id="teacher-row-@staff.Id">
                            <td>@staff.FullName</td>
                            <td>@staff.Email</td>
                            <td>@staff.PhoneNumber</td>
                            <td>@staff.Gender</td>
                            <td>@staff.Role</td>
                            <td>
                                <span class="status status-@staff.Status.ToLower().Replace(" ", "-")">
                                    @staff.Status
                                </span>
                            </td>
                            <td class="actions">
                                <a class="view"
                                   href="@Url.Action("GetDetailId", "Teacher", new { area = "Admin", id = staff.Id })">
                                    View
                                </a>

                                <a class="edit"
                                   href="@Url.Action("Edit", "Teacher", new { area = "Admin", id = staff.Id })">
                                    Edit
                                </a>
                                @if (canDelete)
                                {
                                    <a class="delete"
                                       data-id="@staff.Id"
                                       onclick="confirmDeleteTeacher(@staff.Id)">
                                        Delete
                                    </a>
                                }

                            </td>
                        </tr>
                    }
                }
                
            </tbody>

        </table>
    </div>

    <!-- PAGINATION -->
    <div class="admin-page__pagination-wrapper">
        <div class="admin-page__pagination-info">
            Showing <strong>
                @((Model.PageIndex - 1) * Model.PageSize + 1)
                –
                @(Math.Min(Model.PageIndex * Model.PageSize, Model.TotalRecords))
            </strong>
            of
            <strong>@Model.TotalRecords</strong>
            records
        </div>

        <div class="admin-page__pagination">
            <!-- Prev -->
            <button class="btn-prev"
                    onclick="location.href='@Url.Action("Index", new { page = Model.PageIndex - 1, search = ViewBag.teacherSearch  })'"
            @(Model.HasPrevious ? "" : "disabled")>
                ‹ Prev
            </button>

            <!-- Page 1 -->
            <button class="@(Model.PageIndex == 1 ? "active" : "")"
                    onclick="location.href='@Url.Action("Index", new { page = 1, search = ViewBag.teacherSearch })'">
                1
            </button>

            @{
                int start = Math.Max(2, Model.PageIndex - 2);
                int end = Math.Min(Model.TotalPages - 1, Model.PageIndex + 2);
            }

            <!-- ... trước -->
            @if (start > 2)
            {
                <span class="pagination-dots">...</span>
            }

            <!-- Pages giữa -->
            @for (int i = start; i <= end; i++)
            {
                if (i == Model.PageIndex)
                {
                    <button class="active">@i</button>
                }
                else
                {
                    <button onclick="location.href='@Url.Action("Index", new { page = i, search = ViewBag.teacherSearch })'">
                        @i
                    </button>
                }
            }

            <!-- ... sau -->
            @if (end < Model.TotalPages - 1)
            {
                <span class="pagination-dots">...</span>
            }

            <!-- Page cuối -->
            @if (Model.TotalPages > 1)
            {
                <button class="@(Model.PageIndex == Model.TotalPages ? "active" : "")"
                        onclick="location.href='@Url.Action("Index", new { page = Model.TotalPages, search = ViewBag.teacherSearch })'">
                    @Model.TotalPages
                </button>
            }

            <!-- Next -->
            <button class="btn-next"
                    onclick="location.href='@Url.Action("Index", new { page = Model.PageIndex + 1, search = ViewBag.teacherSearch })'"
            @(Model.HasNext ? "" : "disabled")>
                Next ›
            </button>
        </div>
    </div>

    <form id="antiForgeryForm" style="display:none;">
        @Html.AntiForgeryToken()
    </form>
</div>
