@using System.Security.Claims
@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var loginName = User.FindFirst(ClaimTypes.Name)?.Value;
    var isAdmin = User.IsInRole("Admin");
    var isManager = User.IsInRole("Manager"); 
    var isTeacher = User.IsInRole("Teacher");
    var isHR = User.IsInRole("HR");
    var isCoordinator = User.IsInRole("Coordinator");

    var canViewDashboard = isAdmin || isManager;
    var canManageUsers = isAdmin || isManager || isHR;
    var canManageClass = isAdmin || isManager || isCoordinator;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Admin | @ViewData["Title"]</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="stylesheet" href="~/css/admin/admin.css" />
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    @RenderSection("css", required: false)
</head>
<body>

    <div class="admin-wrapper">
        <!-- SIDEBAR -->
        <aside class="sidebar">
            <div class="sidebar-logo">
                English Centre
            </div>

            <ul class="menu">

                @if (canViewDashboard)
                {
                    <li class="menu-item @(controller == "Home" ? "active" : "")">
                        <a href="@Url.Action("Index", "Home", new { area = "Admin" })">
                            <div class="left">
                                <span class="fa-solid fa-house"></span>
                                <span class="text">Home</span>
                            </div>
                        </a>
                    </li>
                }

                @if (canViewDashboard)
                {
                    <li class="menu-item @(controller == "Course" ? "active" : "")">
                        <a href="@Url.Action("Index", "Course", new { area = "Admin" })">
                            <div class="left">
                                <span class="fa-solid fa-book-open"></span>
                                <span class="text">Course</span>
                            </div>
                        </a>
                    </li>
                }

                @if (canViewDashboard)
                {
                    <li class="menu-item @(controller == "Cost" ? "active" : "")">
                        <a href="@Url.Action("Index", "Cost", new { area = "Admin" })">
                            <div class="left">
                                <span class="fa-solid fa-money-bill-wave"></span>
                                <span class="text">Cost</span>
                            </div>
                        </a>
                    </li>
                }

                @if (canManageUsers)
                {
                    <li class="menu-item has-sub @(controller == "Teacher" || controller == "Student" ? "open active" : "")">
                        <div class="menu-link">
                            <div class="left">
                                <span class="fa-solid fa-user"></span>
                                <span class="text">User</span>
                            </div>
                            <span class="arrow"></span>
                        </div>

                        <ul class="submenu">
                            <li>
                                <a href="@Url.Action("Index", "Teacher", new { area = "Admin" })"
                                   class="@(controller == "Teacher" ? "active" : "")">
                                    Staff
                                </a>
                            </li>
                            @if (canManageClass)
                            {
                                <li>
                                    <a href="@Url.Action("Index", "Student", new { area = "Admin" })"
                                       class="@(controller == "Student" ? "active" : "")">
                                        Student
                                    </a>
                                </li>
                            }
                        </ul>
                    </li>


                }
                @if (canManageClass || isTeacher)
                {
                    <li class="menu-item has-sub @(controller == "Class" ? "open active" : "")">
                        <div class="menu-link">
                            <div class="left">
                                <span class="fa-solid fa-chalkboard-user"></span>
                                <span class="text">Class</span>
                            </div>
                            <span class="arrow"></span>
                        </div>

                        <ul class="submenu">

                            @if (canManageClass)
                            {
                                <li>
                                    <a href="@Url.Action("Index", "Class", new { area = "Admin" })"
                                       class="@(controller == "Class" && action == "Index" ? "active" : "")">
                                        Class Management
                                    </a>
                                </li>
                            }

                            @if (isTeacher)
                            {
                                <li>
                                    <a href="@Url.Action("MyClass", "Class", new { area = "Admin" })"
                                       class="@(controller == "Class" && action == "MyClass" ? "active" : "")">
                                        My Class
                                    </a>
                                </li>
                            }

                        </ul>
                    </li>
                }
                

                <li class="menu-item @(controller == "Calendar" ? "active" : "")">
                    <a href="@Url.Action("Index", "Calendar", new { area = "Admin" })">
                        <div class="left">
                            <span class="fa-solid fa-calendar-days"></span>
                            <span class="text">Calendar</span>
                        </div>
                    </a>
                </li>

                @if (canManageClass)
                {
                    <li class="menu-item @(controller == "Enrollment" ? "active" : "")">
                        <a href="@Url.Action("Index", "Enrollment", new { area = "Admin" })">
                            <div class="left">
                                <span class="fa-solid fa-user-plus"></span>
                                <span class="text">Student Contract</span>
                            </div>
                        </a>
                    </li>
                }


            </ul>
        </aside>

        <!-- MAIN -->
        <div class="main">

            <!-- HEADER -->
            <header class="topbar">
                <div class="topbar-left">
                    <button class="toggle-btn">☰</button>
                </div>

                <div class="topbar-right">
                    <div class="user-dropdown">
                        <img src="/assets/img/avatar-default.png" class="avatar" />
                        <span class="username">@loginName</span>

                        <div class="dropdown-menu">
                            <a href="@Url.Action("Index", "Profile", new { area = "Admin" })">Profile</a>
                            <a onclick="openPasswordModal()">Change Password</a>
                            <hr />
                            <a href="@Url.Action("Logout","login", new { area = "Admin" })">Logout</a>
                        </div>
                    </div>
                </div>
            </header>

            <!-- CONTENT -->
            <main class="content">
                @RenderBody()
            </main>

        </div>

        <!-- Pop-Up -->
        <div id="confirmModal" class="confirm-modal hidden">
            <div class="confirm-backdrop"></div>

            <div class="confirm-box">
                <h3 id="confirmTitle">Confirm</h3>
                <p id="confirmMessage">Are you sure?</p>

                <div class="confirm-actions">
                    <button id="confirmCancel" class="btn btn-cancel">Cancel</button>
                    <button id="confirmOk" class="btn btn-danger">Delete</button>
                </div>
            </div>
        </div>

        <!-- Toast-Success -->
        <div id="toast"
             class="toast hidden">
            <span id="toastMessage"></span>
        </div>

        <!-- Modal Change Password -->
        <div class="modalpassword" id="passwordModal">
            <div class="modalpassword-overlay" onclick="closePasswordModal()"></div>

            <div class="modalpassword-content">
                <div class="form-group">
                    <label>New Password</label>
                    <input class="form-control" id="changePass" name="changePass" type="password" required />
                </div>

                <div class="form-group">
                    <label>Confirm Password</label>
                    <input id="newPassConfirm"
                           name="newPassConfirm"
                           type="password"
                           required
@*                            oninput="validateConfirmPassword()" 
 *@                    />
                </div>
                <div class="show-password">
                    <input type="checkbox" onclick="showPassword()">
                    <label for="showPassword">Show password</label>
                </div>
                <div class="modalpassword-actions">
                    <button class="btn outline" type="button" onclick="closePasswordModal()">Cancel</button>
                    <button class="btn primary" type="button" onclick="savePassword()">Save</button>
                </div>
            </div>
        </div>
        <form id="antiForgeryForm" style="display:none;">
            @Html.AntiForgeryToken()
        </form>
    </div>

    @if (TempData["ToastMessage"] != null)
    {
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                showToast(
                    '@TempData["ToastMessage"]',
                    '@TempData["ToastType"]'
                );
            });
        </script>
    }
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <!-- SCRIPT SECTION: -->
    @RenderSection("Scripts", required: false)
    <script src="~/js/admin/admin-layout.js"></script>
    <script src="~/js/admin/toast-modal.js"></script>
    <script src="~/js/admin/confirm-modal.js"></script>
    <script src="~/js/admin/toggle-dropdown.js"></script>
    <script src="~/js/admin/admin-class-viewdetail-modal.js"></script>
    <script src="~/js/admin/admin-class-add-remove-student.js"></script>
    <script src="~/js/admin/admin-contract.js"></script>
    <script src="~/js/admin/currency.js"></script>
    <script src="~/js/admin/change-password.js"></script>
    <script src="~/js/admin/admin-cost-chart.js"></script>
    <script src="~/js/admin/admin-home-chart.js"></script>
    <script src="~/js/admin/admin-cost.js"></script>
    <script src="~/js/admin/admin-download-excel.js"></script>
    <script src="~/js/admin/admin-class-session.js"></script>

</body>
</html>

