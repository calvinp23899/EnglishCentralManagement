@model PagedResult<SectionContentItemDto>

<div class="admin-page admin-teacher">
    <!-- HEADER -->
    <div class="admin-page__header">
        <h1>Section Content Management</h1>
        <a class="btn-primary" onclick="createContentDrawer()">
            + New Content
        </a>
    </div>

    <!-- TABLE -->
    <div class="admin-page__table">
        <table>
            <thead>
                <tr>
                    <th>SectionTitle</th>
                    <th>ContentTitle</th>
                    <th>Order</th>
                    <th>Status</th>
                    <th>CreatedBy</th>
                    <th>CreatedDate</th>
                    <th>UpdatedBy</th>
                    <th>UpdatedDate</th>
                    <th width="120">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || !Model.Items.Any())
                {
                    <tr>
                        <td colspan="5" style="text-align:center;">
                            No content found
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model.Items)
                    {
                        <tr id="content-row-@item.Id">
                            <td>@item.NavTitleSection</td>
                            <td style="max-width: 200px; overflow: hidden; white-space: nowrap; text-overflow: ellipsis;"
                                title="@item.Title">
                                @item.Title
                            </td>
                            <td>@item.Order</td>
                            <td>
                                <span class="status status-@item.Status.ToLower().Replace(" ", "-")">
                                    @item.Status
                                </span>
                            </td>
                            <td>@item.CreatedBy</td>
                            <td>@item.CreatedDate?.ToString("yyyy-MM-dd")</td>
                            <td>@item.UpdatedBy</td>
                            <td>@item.UpdatedDate?.ToString("yyyy-MM-dd")</td>
                            <td class="actions">
                                <a class="edit"
                                   onclick="updateContentDrawer(@item.Id)">
                                    Edit
                                </a>
                                <a class="delete @(item.Status.ToLower().Equals("inactive") ? "" : "disabled")"
                                   onclick="@(item.Status.ToLower().Equals("inactive") ? $"confirmDeleteContent({item.Id})" : "return false;")">
                                    Delete
                                </a>

                            </td>
                        </tr>
                    }
                }

            </tbody>

        </table>
    </div>

    <!-- PAGINATION -->
    <div class="admin-page__pagination-wrapper">
        <div class="admin-page__pagination-info">
            Showing <strong>
                @((Model.PageIndex - 1) * Model.PageSize + 1)
                –
                @(Math.Min(Model.PageIndex * Model.PageSize, Model.TotalRecords))
            </strong>
            of
            <strong>@Model.TotalRecords</strong>
            records
        </div>

        <div class="admin-page__pagination">
            <!-- Prev -->
            <button class="btn-prev"
                    onclick="loadNav(@(Model.PageIndex - 1))"
            @(Model.HasPrevious ? "" : "disabled")>
                ‹ Prev
            </button>

            <!-- Page 1 -->
            <button class="@(Model.PageIndex == 1 ? "active" : "")"
                    onclick="loadNav(1)">
                1
            </button>

            @{
                int start = Math.Max(2, Model.PageIndex - 2);
                int end = Math.Min(Model.TotalPages - 1, Model.PageIndex + 2);
            }

            <!-- ... trước -->
            @if (start > 2)
            {
                <span class="pagination-dots">...</span>
            }

            <!-- Pages giữa -->
            @for (int i = start; i <= end; i++)
            {
                if (i == Model.PageIndex)
                {
                    <button class="active">@i</button>
                }
                else
                {
                    <button onclick="loadNav(@i)">
                        @i
                    </button>
                }
            }

            <!-- ... sau -->
            @if (end < Model.TotalPages - 1)
            {
                <span class="pagination-dots">...</span>
            }

            <!-- Page cuối -->
            @if (Model.TotalPages > 1)
            {
                <button class="@(Model.PageIndex == Model.TotalPages ? "active" : "")"
                        onclick="loadNav(@Model.TotalPages)">
                    @Model.TotalPages
                </button>
            }

            <!-- Next -->
            <button class="btn-next"
                    onclick="loadNav(@Model.PageIndex + 1)"
            @(Model.HasNext ? "" : "disabled")>
                Next ›
            </button>
        </div>
    </div>

    <form id="antiForgeryForm" style="display:none;">
        @Html.AntiForgeryToken()
    </form>
</div>