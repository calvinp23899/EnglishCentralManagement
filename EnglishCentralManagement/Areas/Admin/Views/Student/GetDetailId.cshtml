@model CreatedStudentDto
<div class="teacher-form view-only">
    <div class="teacher-form__header">
        <h2>Student Information</h2>
    </div>

    <div class="teacher-form__grid">

        <div class="form-group">
            <label>First Name</label>
            <div class="form-value">@Model.FirstName</div>
        </div>

        <div class="form-group">
            <label>Last Name</label>
            <div class="form-value">@Model.LastName</div>
        </div>

        <div class="form-group">
            <label>Date of Birth</label>
            <div class="form-value">@Model.DateOfBirth</div>
        </div>

        <div class="form-group">
            <label>Phone Number</label>
            <div class="form-value">@Model.PhoneNumber</div>
        </div>

        <div class="form-group">
            <label>Email</label>
            <div class="form-value">@Model.Email</div>
        </div>

        <div class="form-group">
            <label>Status</label>
            <span class="form-value">@Model.Status</span>
        </div>
        
        <div class="form-group">
            <label>Gender</label>
            <span class="form-value">@Model.Gender</span>
        </div>

        <div class="form-group">
            <label>CreatedBy</label>
            <span class="form-value">@Model.CreatedBy</span>
        </div>

        <div class="form-group">
            <label>CreatedDate</label>
            <span class="form-value">@Model.CreatedDate?.ToString("yyyy-MM-dd")</span>
        </div>

        <div class="form-group">
            <label>UpdatedBy</label>
            <span class="form-value">@Model.UpdatedBy</span>
        </div>

        <div class="form-group">
            <label>UpdatedDate</label>
            <span class="form-value">@Model.UpdatedDate?.ToString("yyyy-MM-dd")</span>
        </div>

        <div class="form-group full">
            <label>Address</label>
            <div class="form-value">@Model.Address</div>
        </div>

    </div>
</div>

