@{
    var genders = Enum.GetValues(typeof(GenderEnum)).Cast<GenderEnum>();
    var studentStatuses = Enum.GetValues(typeof(StudentStatus)).Cast<StudentStatus>();
    var roleTypes = Enum.GetValues(typeof(RoleType)).Cast<RoleType>();
}
<div class="teacher-form__grid">
    <!-- First Name -->
    <div class="form-group">
        <label>First Name</label>
        <input type="text" placeholder="John" name="FirstName" value="@Model?.FirstName" required />
    </div>

    <!-- Last Name -->
    <div class="form-group">
        <label>Last Name</label>
        <input type="text" placeholder="Doe" name="LastName" value="@Model?.LastName" required />
    </div>

    <!-- Date of Birth -->
    <div class="form-group">
        <label>Date of Birth</label>
        <input type="date" name="DateOfBirth" value="@(Model?.DateOfBirth?.ToString("yyyy-MM-dd"))" required />
    </div>

    <!-- Phone Number -->
    <div class="form-group">
        <label>Phone Number</label>
        <input type="text" placeholder="0123456789" name="PhoneNumber" value="@Model?.PhoneNumber" required />
    </div>

    <!-- Email -->
    <div class="form-group">
        <label>Email</label>
        <input type="email" placeholder="teacher@email.com" name="Email" value="@Model?.Email" required />
    </div>

    <!-- Status -->
    <div class="form-group">
        <label>Status</label>
        <select name="Status">
            <option value="">-- Select Status --</option>

            @foreach (var itemStatus in studentStatuses)
            {
                if (Model?.Status == itemStatus)
                {
                    <option value="@( (int)itemStatus )" selected="selected">
                        @itemStatus
                    </option>
                }
                else
                {
                    <option value="@( (int)itemStatus )">
                        @itemStatus
                    </option>
                }
            }
        </select>
    </div>

    <!-- Gender -->
    <div class="form-group">
        <label>Gender</label>
        <select name="Gender" required>
            <option value="">-- Select Gender --</option>

            @foreach (var item in genders)
            {
                if (Model?.Gender == item)
                {
                    <option value="@( (int)item )" selected="selected">
                        @item
                    </option>
                }
                else
                {
                    <option value="@( (int)item )">
                        @item
                    </option>
                }
            }
        </select>
    </div>

    <!-- Address -->
    <div class="form-group full">
        <label>Address</label>
        <input placeholder="Teacher address..." name="Address" value="@Model?.Address" required></input>
    </div>

    <div class="form-section account-section">
        <div class="section-title">Account Information</div>

        <!-- Username -->
        <div class="form-group">
            <label>Username</label>
            <input placeholder="" name="Username" value="@Model?.Username" required></input>
        </div>

        <!-- Username -->
        <div class="form-group">
            <label>Password</label>
            <input type="password" placeholder="••••••••" name="Password" value="@Model?.Password" required></input>
        </div>

        <!-- Role -->
        <div class="form-group">
            <label>Role</label>
            <select name="Role" required>
                <option value="">-- Select Role --</option>

                @foreach (var item in roleTypes)
                {
                    if (Model?.Role == item)
                    {
                        <option value="@( (int)item )" selected="selected">
                            @item
                        </option>
                    }
                    else
                    {
                        <option value="@( (int)item )">
                            @item
                        </option>
                    }
                }
            </select>
        </div>
    </div>
</div>