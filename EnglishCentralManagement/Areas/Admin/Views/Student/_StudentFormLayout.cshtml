@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
@{
    var genders = Enum.GetValues(typeof(GenderEnum)).Cast<GenderEnum>();
    var studentStatuses = Enum.GetValues(typeof(StudentStatus)).Cast<StudentStatus>();
    var roleTypes = Enum.GetValues(typeof(RoleType)).Cast<RoleType>();
    bool isEdit = ViewBag.IsEdit ?? false;
}
<div class="teacher-form__grid">
    <!-- First Name -->
    <div class="form-group">
        <label>First Name</label>
        <input type="text" placeholder="John" name="FirstName" value="@Model?.FirstName"  />
        @Html.ValidationMessage("FirstName", "", new { @class = "text-danger" })
    </div>

    <!-- Last Name -->
    <div class="form-group">
        <label>Last Name</label>
        <input type="text" placeholder="Doe" name="LastName" value="@Model?.LastName"  />
        @Html.ValidationMessage("LastName", "", new { @class = "text-danger" })
    </div>

    <!-- Date of Birth -->
    <div class="form-group">
        <label>Date of Birth</label>
        <input type="date" name="DateOfBirth" value="@(Model?.DateOfBirth?.ToString("yyyy-MM-dd"))" />
        @Html.ValidationMessage("DateOfBirth", "", new { @class = "text-danger" })

    </div>

    <!-- Phone Number -->
    <div class="form-group">
        <label>Phone Number</label>
        <input type="text" placeholder="0123456789" name="PhoneNumber" value="@Model?.PhoneNumber" />
        @Html.ValidationMessage("PhoneNumber", "", new { @class = "text-danger" })
    </div>

    <!-- Email -->
    <div class="form-group">
        <label>Email</label>
        <input type="email" placeholder="student@email.com" name="Email" value="@Model?.Email"  />
        @Html.ValidationMessage("Email", "", new { @class = "text-danger" })
    </div>

    <!-- Status -->
    @if (isEdit)
    {
        <div class="form-group">
            <label>Status</label>
            <select name="Status">
                <option value="">-- Select Status --</option>

                @foreach (var itemStatus in studentStatuses)
                {
                    if (Model?.Status == itemStatus)
                    {
                        <option value="@( (int)itemStatus )" selected="selected">
                            @itemStatus
                        </option>
                    }
                    else
                    {
                        <option value="@( (int)itemStatus )">
                            @itemStatus
                        </option>
                    }
                }
            </select>
            @Html.ValidationMessage("Status", "", new { @class = "text-danger" })
        </div>
    }
    

    <!-- Gender -->
    <div class="form-group">
        <label>Gender</label>
        <select name="Gender">
            <option value="">-- Select Gender --</option>

            @foreach (var item in genders)
            {
                if (Model?.Gender == item)
                {
                    <option value="@( (int)item )" selected="selected">
                        @item
                    </option>
                }
                else
                {
                    <option value="@( (int)item )">
                        @item
                    </option>
                }
            }
        </select>
        @Html.ValidationMessage("Gender", "", new { @class = "text-danger" })
    </div>

    <!-- Address -->
    <div class="form-group full">
        <label>Address</label>
        <input placeholder="Teacher address..." name="Address" value="@Model?.Address" ></input>
        @Html.ValidationMessage("Address", "", new { @class = "text-danger" })

    </div>

    <div class="form-section account-section">
        <div class="section-title">Account Information</div>

        <!-- Username -->
        <div class="form-group">
            <label>Username</label>
            <input placeholder="" name="Username" value="@Model?.Username" @(isEdit ? "disabled" : "")></input>
            @Html.ValidationMessage("Username", "", new { @class = "text-danger" })
        </div>

        <!-- Password -->
        <div class="form-group">
            <label>Password</label>
            <input type="password" name="Password" value="@Model?.Password" ></input>
            @Html.ValidationMessage("Password", "", new { @class = "text-danger" })
        </div>
    </div>
</div>