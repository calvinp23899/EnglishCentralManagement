@model PagedResult<SessionDto>

<div class="admin-page admin-teacher">
    <!-- HEADER -->
    <div class="admin-page__header">
        <h1>Session Management</h1>
        <a class="btn-primary" onclick="createSessionDrawer()">
            + New Session
        </a>
    </div>

    <!-- TOOLBAR -->
    <div class="admin-page__toolbar">
        <input type="text" id="searchSessionName" value="@ViewBag.sessionSearch" placeholder="Search session name..." />
        <button class="btn-search" onclick="searchSessionName()">Search</button>
    </div>

    <!-- TABLE -->
    <div class="admin-page__table">
        <table>
            <thead>
                <tr>
                    <th>SessionName</th>
                    <th>Date</th>
                    <th>StartedTime</th>
                    <th>EndedTime</th>
                    <th>Attendance</th>
                    <th>Status</th>
                    <th width="120">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || !Model.Items.Any())
                {
                    <tr>
                        <td colspan="5" style="text-align:center;">
                            No session found
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model.Items)
                    {
                        <tr id="session-row-@item.Id">
                            <td>@item.SessionName</td>
                            <td>@item.SessionDate?.ToString("yyyy-MM-dd")</td>
                            <td>@item.StartTime</td>
                            <td>@item.EndTime</td>
                            <td>@item.Attendance</td>
                            <td>
                                <span class="status status-@item.SessionStatus.ToLower()">
                                    @item.SessionStatus
                                </span>
                            </td>
                            <td class="actions">
                                <a class="view"
                                   onclick="viewSessionDrawer(@item.Id)">
                                    View
                                </a>

                                <a class="edit"
                                   onclick="editSessionDrawer(@item.Id)">
                                    Edit
                                </a>

                                <a class="delete"
                                   onclick="confirmDeleteSession(@item.Id)">
                                    Delete
                                </a>

                                <a class="view"
                                   onclick="loadAttendanceStudents(@item.Id)">
                                    Attendance
                                </a>
                            </td>
                        </tr>
                    }
                }

            </tbody>

        </table>
    </div>

    <!-- PAGINATION -->
    <div class="admin-page__pagination-wrapper">
        <div class="admin-page__pagination-info">
            Showing <strong>
                @((Model.PageIndex - 1) * Model.PageSize + 1)
                –
                @(Math.Min(Model.PageIndex * Model.PageSize, Model.TotalRecords))
            </strong>
            of
            <strong>@Model.TotalRecords</strong>
            records
        </div>

        <div class="admin-page__pagination">
            <!-- Prev -->
            <button class="btn-prev"
                    onclick="loadSession(@(Model.PageIndex - 1), '@ViewBag.sessionSearch')"
            @(Model.HasPrevious ? "" : "disabled")>
                ‹ Prev
            </button>

            <!-- Page 1 -->
            <button class="@(Model.PageIndex == 1 ? "active" : "")"
                    onclick="loadSession(1, '@ViewBag.sessionSearch')">
                1
            </button>
            @{
                int start = Math.Max(2, Model.PageIndex - 2);
                int end = Math.Min(Model.TotalPages - 1, Model.PageIndex + 2);
            }
            <!-- Pages giữa -->
            @for (int i = start; i <= end; i++)
            {
                if (i == Model.PageIndex)
                {
                    <button class="active">@i</button>
                }
                else
                {
                    <button onclick="loadSession(@i, '@ViewBag.sessionSearch')">@i</button>
                }
            }

            <!-- Page cuối -->
            @if (Model.TotalPages > 1)
            {
                <button class="@(Model.PageIndex == Model.TotalPages ? "active" : "")"
                        onclick="loadSession(@Model.TotalPages, '@ViewBag.sessionSearch')">
                    @Model.TotalPages
                </button>
            }

            <!-- Next -->
            <button class="btn-next"
                    onclick="loadSession(@(Model.PageIndex + 1), '@ViewBag.sessionSearch')"
            @(Model.HasNext ? "" : "disabled")>
                Next ›
            </button>
        </div>
    </div>

    <form id="antiForgeryForm" style="display:none;">
        @Html.AntiForgeryToken()
    </form>
</div>