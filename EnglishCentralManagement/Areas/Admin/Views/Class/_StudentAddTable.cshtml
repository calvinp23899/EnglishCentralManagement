@model PagedResult<StudentListDto>

<!-- All Students Content -->
<div class="table-detail-form__header">
    <h2>Add Student To Class</h2>
</div>

<!-- TOOLBAR -->
<div class="admin-page__toolbar">
    <input type="text" id="searchStudentAdd" placeholder="Search teacher..." value="@ViewBag.searchStudentToAdd" />
    <button class="btn-search" onclick="GetStudentAddTable(1)">Search</button>
</div>

<div class="admin-page__table">
    <div class="table-detail-form__content">
        <table>
            <thead>
                <tr>
                    <th>FullName</th>
                    <th>Email</th>
                    <th>PhoneNumber</th>
                    <th>StudentStatus</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || !Model.Items.Any())
                {
                    <tr>
                        <td colspan="5" style="text-align:center;">
                            No Students found
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var studentItem in Model.Items)
                    {
                        <tr>
                            <td>@studentItem.FullName</td>
                            <td>@studentItem.Email</td>
                            <td>@studentItem.PhoneNumber</td>
                            <td>@studentItem.Status</td>
                            <td class="actions">
                                <a class="view"
                                   data-id="@studentItem.Id"
                                   onclick="openAddModal(@studentItem.Id)">
                                    Add
                                </a>

                            </td>
                        </tr>
                    }
                }

            </tbody>

        </table>
    </div>

</div>

<!-- PAGINATION -->
<div class="admin-page__pagination-wrapper">
    <div class="admin-page__pagination-info">
        Showing <strong>
            @((Model.PageIndex - 1) * Model.PageSize + 1)
            –
            @(Math.Min(Model.PageIndex * Model.PageSize, Model.TotalRecords))
        </strong>
        of
        <strong>@Model.TotalRecords</strong>
        records
    </div>

    <div class="admin-page__pagination">
        <!-- Prev -->
        <button class="btn-prev"
                onclick=" GetStudentAddTable(@(Model.PageIndex - 1))"
        @(Model.HasPrevious ? "" : "disabled")>
            ‹ Prev
        </button>

        <!-- Page 1 -->
        <button class="@(Model.PageIndex == 1 ? "active" : "")"
                onclick="GetStudentAddTable(1)">
            1
        </button>

        @{
            int start2 = Math.Max(2, Model.PageIndex - 2);
            int end2 = Math.Min(Model.TotalPages - 1, Model.PageIndex + 2);
        }

        <!-- ... trước -->
        @if (start2 > 2)
        {
            <span class="pagination-dots">...</span>
        }

        <!-- Pages giữa -->
        @for (int i = start2; i <= end2; i++)
        {
            if (i == Model.PageIndex)
            {
                <button class="active">@i</button>
            }
            else
            {
                <button onclick="GetStudentAddTable(@i)">
                    @i
                </button>
            }
        }

        <!-- ... sau -->
        @if (end2 < Model.TotalPages - 1)
        {
            <span class="pagination-dots">...</span>
        }

        <!-- Page cuối -->
        @if (Model.TotalPages > 1)
        {
            <button class="@(Model.PageIndex == Model.TotalPages ? "active" : "")"
                    onclick="GetStudentAddTable(@Model.TotalPages)">
                @Model.TotalPages
            </button>
        }

        <!-- Next -->
        <button class="btn-next"
                onclick="GetStudentAddTable(@(Model.PageIndex + 1))"
        @(Model.HasNext ? "" : "disabled")>
            Next ›
        </button>
    </div>
</div>