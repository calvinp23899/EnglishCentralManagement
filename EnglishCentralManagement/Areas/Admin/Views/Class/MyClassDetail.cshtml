@model ClassDetailDto
@{
    var SessionStatus = Enum.GetValues(typeof(SessionStatusEnum)).Cast<SessionStatusEnum>();

}
<div class="teacher-form view-only">
    <div class="class-detail-tabs" data-tab-scope="myclass">
        <button class="tab-btn active" data-tab="classinfo">ClassInfo</button>
        <button class="tab-btn" data-tab="studentinfo">Students</button>
        <button class="tab-btn" data-tab="sessioninfo">Sessions</button>
    </div>
    <div class="tab-content">
        <!-- TAB: ClassInfo-->
        <div id="tab-classinfo" class="tab-pane active">

            <div class="teacher-form__header">
                <h2>Class Information</h2>
            </div>

            <div class="teacher-form__grid">

                <div class="form-group">
                    <label>ClassCode</label>
                    <div class="form-value">@Model?.ClassCode</div>
                </div>
                <input type="hidden" id="myClassId" value="@Model?.ClassId" />

                <div class="form-group">
                    <label>Course</label>
                    <div class="form-value">@Model?.CourseName</div>
                </div>

                <div class="form-group">
                    <label>StartDate</label>
                    <div class="form-value">@Model?.StartDate</div>
                </div>

                <div class="form-group">
                    <label>EndDate</label>
                    <div class="form-value">@Model?.EndDate</div>
                </div>

                <div class="form-group">
                    <label>CountStudent</label>
                    <div class="form-value">@Model?.MaxStudents</div>
                </div>

                <div class="form-group">
                    <label>Status</label>
                    <span class="form-value">@Model?.Status</span>
                </div>

                <div class="form-group full">
                    <label>Homeroom-Teacher</label>
                    <div class="form-value">@Model?.TeacherName</div>
                </div>

                <div class="form-group full">
                    <label>Note</label>
                    <div class="form-value">@Model?.Note</div>
                </div>

            </div>

        </div>

        <!-- TAB: StudentTable-->
        <div id="tab-studentinfo" class="tab-pane">
            <div class="teacher-form__header">
                <h2>Students In Class</h2>
            </div>
            <div class="admin-page__table">
                <div class="table-detail-form__content">
                    <table>
                        <thead>
                            <tr>
                                <th>FullName</th>
                                <th>Email</th>
                                <th>PhoneNumber</th>
                                <th>EnrollmentStatus</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model == null || !Model.StudentsInClass.Items.Any())
                            {
                                <tr>
                                    <td colspan="5" style="text-align:center;">
                                        No Students found
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var studentItem in Model?.StudentsInClass.Items)
                                {
                                    <tr>
                                        <td>@studentItem.FullName</td>
                                        <td>@studentItem.Email</td>
                                        <td>@studentItem.PhoneNumber</td>
                                        <td>@studentItem.EnrollmentStatus</td>
                                    </tr>
                                }
                            }

                        </tbody>

                    </table>
                </div>

            </div>

            <!-- PAGINATION -->
            <div class="admin-page__pagination-wrapper">
                <div class="admin-page__pagination-info">
                    Showing <strong>
                        @((Model.StudentsInClass.PageIndex - 1) * Model.StudentsInClass.PageSize + 1)
                        –
                        @(Math.Min(Model.StudentsInClass.PageIndex * Model.StudentsInClass.PageSize, Model.StudentsInClass.TotalRecords))
                    </strong>
                    of
                    <strong>@Model.StudentsInClass.TotalRecords</strong>
                    records
                </div>

                <div class="admin-page__pagination">
                    <!-- Prev -->
                    <button class="btn-prev"
                            onclick="location.href='@Url.Action("Index", new { page = Model.StudentsInClass.PageIndex - 1 })'"
                    @(Model.StudentsInClass.HasPrevious ? "" : "disabled")>
                        ‹ Prev
                    </button>

                    <!-- Page 1 -->
                    <button class="@(Model.StudentsInClass.PageIndex == 1 ? "active" : "")"
                            onclick="location.href='@Url.Action("Index", new { page = 1 })'">
                        1
                    </button>

                    @{
                        int start = Math.Max(2, Model.StudentsInClass.PageIndex - 2);
                        int end = Math.Min(Model.StudentsInClass.TotalPages - 1, Model.StudentsInClass.PageIndex + 2);
                    }

                    <!-- ... trước -->
                    @if (start > 2)
                    {
                        <span class="pagination-dots">...</span>
                    }

                    <!-- Pages giữa -->
                    @for (int i = start; i <= end; i++)
                    {
                        if (i == Model.StudentsInClass.PageIndex)
                        {
                            <button class="active">@i</button>
                        }
                        else
                        {
                            <button onclick="location.href='@Url.Action("Index", new { page = i })'">
                                @i
                            </button>
                        }
                    }

                    <!-- ... sau -->
                    @if (end < Model.StudentsInClass.TotalPages - 1)
                    {
                        <span class="pagination-dots">...</span>
                    }

                    <!-- Page cuối -->
                    @if (Model.StudentsInClass.TotalPages > 1)
                    {
                        <button class="@(Model.StudentsInClass.PageIndex == Model.StudentsInClass.TotalPages ? "active" : "")"
                                onclick="location.href='@Url.Action("Index", new { page = Model.StudentsInClass.TotalPages })'">
                            @Model.StudentsInClass.TotalPages
                        </button>
                    }

                    <!-- Next -->
                    <button class="btn-next"
                            onclick="location.href='@Url.Action("Index", new { page = Model.StudentsInClass.PageIndex + 1 })'"
                    @(Model.StudentsInClass.HasNext ? "" : "disabled")>
                        Next ›
                    </button>
                </div>
            </div>
        </div>

        <!-- TAB: SessionInfo-->
        <div id="tab-sessioninfo" class="tab-pane">
            <div id="classSessionContent"></div>
        </div>
    </div>
    @*======== RIGHT HIDDEN MODAL - VIEW, EDIT, CREATE =========*@
    <div class="expense-drawer" id="sessionDrawer">
        <div class="drawer-overlay" onclick="closeSessionDrawer()"></div>

        <div class="drawer-content">
            <div class="drawer-header">
                <h3>Session Info</h3>
                <button class="close-btn" onclick="closeSessionDrawer()">✕</button>
            </div>

            <div class="drawer-body">
                <input type="hidden" id="SessionId" />

                <div class="form-group">
                    <label>SessionName</label>
                    <input id="SessionName" type="text" />
                </div>

                <div class="form-group">
                    <label>SessionDate</label>
                    <input id="SessionDate" type="date" />
                </div>

                <div class="form-group">
                    <label>StartTime</label>
                    <input id="SessionStartTime" type="time" />
                </div>

                <div class="form-group">
                    <label>EndTime</label>
                    <input id="SessionEndTime" type="time" />
                </div>

                <!-- Contract Type -->
                <div class="form-group">
                    <label>Status</label>
                    <select id="SessionStatus">
                        <option value="">-- Select Status --</option>
                        @foreach (var itemSessionStatus in SessionStatus)
                        {
                            <option value="@( (int)itemSessionStatus )">
                                @itemSessionStatus
                            </option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label>FeedBack</label>
                    <textarea id="SessionFeedback" rows="3"></textarea>
                </div>

                <div class="form-group">
                    <label>Note</label>
                    <textarea id="SessionNote" rows="3"></textarea>
                </div>
                <div class="form-group">
                    <label>CreatedBy</label>
                    <input id="SessionCreatedBy" type="text" />
                </div>
                <div class="form-group">
                    <label>CreatedDate</label>
                    <input id="SessionCreatedDate" type="date" />
                </div>

                <div class="form-group">
                    <label>UpdatedBy</label>
                    <input id="SessionUpdatedBy" type="text" />
                </div>

                <div class="form-group">
                    <label>UpdatedDate</label>
                    <input id="SessionUpdatedDate" type="date" />
                </div>
            </div>

            <div class="drawer-footer">
                <button class="btn-primary" onclick="closeSessionDrawer()">Cancel</button>
                <button class="btn-primary" id="btnSaveSession" onclick="confirmSaveSession()">Save</button>
                <button class="btn-primary" id="btnCreateSession" onclick="createSession()">Create</button>
            </div>
        </div>
    </div>

    @*======== Attendance =========*@
    <div class="expense-drawer" id="attendanceDrawer">
        <div class="drawer-overlay" onclick="closeAttendanceDrawer()"></div>

        <div class="drawer-content">
            <div class="drawer-header">
                <h3>Attendance</h3>
                <button class="close-btn" onclick="closeAttendanceDrawer()">✕</button>
            </div>

            <div class="drawer-body">
                <input type="hidden" id="sessionIdHidden" />
                <table class="attendance-table">
                    <thead>
                        <tr>
                            <th>Student Name</th>
                            <th>Present</th>
                            <th>Absent</th>
                        </tr>
                    </thead>
                    <tbody id="attendanceList">
                        <!-- JS sẽ render ở đây -->
                    </tbody>
                </table>
            </div>

            <div class="drawer-footer">
                <button class="btn-primary" onclick="closeAttendanceDrawer()">Cancel</button>
                <button class="btn-primary" id="btnSaveAttendace" onclick="confirmSaveAttendance()">Save</button>
            </div>
        </div>
    </div>
</div>
