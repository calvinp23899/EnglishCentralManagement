@model CreatedClassDto

<div class="teacher-form">
    <div class="teacher-form__header">
        <h2>Edit Class</h2>
    </div>

    <form action="Edit" method="post">
        <input type="hidden" name="ClassId" value="@Model.ClassId" />
        @Html.AntiForgeryToken()
        @Html.Partial("_ClassFormLayout", Model)
        <div class="teacher-form__actions">
            <button class="btn primary" type="submit">Save</button>
            <button class="btn outline" type="reset">Cancel</button>
        </div>
    </form>


</div>
