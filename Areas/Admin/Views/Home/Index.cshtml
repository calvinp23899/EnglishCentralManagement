@model DashboardDto
@{
    ViewData["Title"] = "Dashboard";
}
@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="/js/admin/admin-home-chart.js"></script>
}


<div class="dashboard">

    <!-- HEADER -->
    <div class="dashboard__header">
        <h1>Dashboard</h1>
    </div>

    <!-- STATS CARDS -->
    <div class="dashboard__stats">

        <div class="dashboard__stat-card">
            <div class="icon">
                <i class="fa-solid fa-user-graduate"></i>
            </div>
            <div class="info">
                <span class="value">@Model.CountStudent</span>
                <span class="label">Total Students</span>
                <span class="compare">Compared to previous month: 0000000000000</span>
            </div>
        </div>

        <div class="dashboard__stat-card">
            <div class="icon">
                <i class="fa-solid fa-sack-dollar"></i>
            </div>
            <div class="info">
                <span class="value">
                    @Model.RevenueThisMonth.ToString("c0",
                             new System.Globalization.CultureInfo("vi-VN"))
                </span>
                <span class="label">Revenue This Month</span>
                <span class="compare">Compared to previous month:  0000000000000</span>
            </div>
        </div>

        <div class="dashboard__stat-card">
            <div class="icon">
                <i class="fa-solid fa-user"></i>
            </div>
            <div class="info">
                <span class="value">@Model.CountStaff</span>
                <span class="label">Total Teachers</span>
                <span class="compare">Compared to previous month: 0000000000000</span>
            </div>
        </div>

        <div class="dashboard__stat-card">
            <div class="icon">
                <i class="fa-solid fa-book"></i>
            </div>
            <div class="info">
                <span class="value">@Model.CountClass</span>
                <span class="label">Total Classes</span>
                <span class="compare">Compared to previous month: 0000000000000</span>
            </div>
        </div>

    </div>

    <!-- CHART -->
    <div class="dashboard__chart card">
        <h3>Revenue by Month (@Model.ThisYear)</h3>
        <canvas id="revenueChart"></canvas>
    </div>

</div>


