<div class="teacher-form__grid">
    <!-- First Name -->
    <div class="form-group">
        <label>First Name</label>
        <input type="text" placeholder="John" name="FirstName" value="@Model?.FirstName" required/>
    </div>

    <!-- Last Name -->
    <div class="form-group">
        <label>Last Name</label>
        <input type="text" placeholder="Doe" name="LastName" value="@Model?.LastName" required />
    </div>

    <!-- Date of Birth -->
    <div class="form-group">
        <label>Date of Birth</label>
        <input type="date" name="DateOfBirth" value="@Model?.DateOfBirth" required />
    </div>

    <!-- Phone Number -->
    <div class="form-group">
        <label>Phone Number</label>
        <input type="text" placeholder="0123456789" name="PhoneNumber" value="@Model?.PhoneNumber" required />
    </div>

    <!-- Email -->
    <div class="form-group">
        <label>Email</label>
        <input type="email" placeholder="teacher@email.com" name="Email" value="@Model?.Email" required />
    </div>

    <!-- Contract Type -->
    <div class="form-group">
        <label>Contract Type</label>
        <select name="ContractType" value="@Model?.ContractType" asp-items="Html.GetEnumSelectList<ContractType>()">
            <option value="">-- Select Contract Type --</option>
        </select>
    </div>

    <!-- Working Type -->
    <div class="form-group">
        <label>Working Type</label>
        <select name="WorkingType" value="@Model?.WorkingType" asp-items="Html.GetEnumSelectList<WorkingType>()">
            <option value="">-- Select Working Type --</option>
        </select>
    </div>

    <!-- Years of Experience -->
    <div class="form-group">
        <label>Years of Experience</label>
        <input type="number" min="0" name="YearsOfExperience" value="@Model?.YearsOfExperience" />
    </div>

    <!-- Hourly Rate -->
    <div class="form-group">
        <label>Hourly Rate</label>
        <input type="number" placeholder="$ / hour" name="HourlyRate" value="@Model?.HourlyRate" />
    </div>

    <!-- Salary -->
    <div class="form-group">
        <label>Salary</label>
        <input type="number" placeholder="$ / month" name="MonthlySalary" value="@Model?.MonthlySalary" />
    </div>

    <!-- Onboarding Date -->
    <div class="form-group">
        <label>Onboarding Date</label>
        <input type="date" name="OnboardingDate" value="@Model?.OnboardingDate" />
    </div>

    <!-- Gender -->
    <div class="form-group">
        <label>Gender</label>
        <select name="Gender" value="@Model?.Gender" asp-items="Html.GetEnumSelectList<GenderEnum>()" required>
            <option value="">-- Select Gender --</option>
        </select>
    </div>

    <!-- Address -->
    <div class="form-group">
        <label>Address</label>
        <input placeholder="1A Street..." name="Address" value="@Model?.Address" required></input>
    </div>

    <!-- Title -->
    <div class="form-group">
        <label>Title</label>
        <input placeholder="Junior Teacher..." name="Title" value="@Model?.Title" required></input>
    </div>

    <!-- Avatar -->
    <div class="form-group full">
        <label>Avatar</label>
        <input type="file" name="Avatar" value="@Model?.Avatar" />
    </div>

    <div class="form-section account-section">
        <div class="section-title">Account Information</div>

        <!-- Username -->
        <div class="form-group">
            <label>Username</label>
            <input placeholder="" name="Username" value="@Model?.Username" required></input>
        </div>

        <!-- Username -->
        <div class="form-group">
            <label>Password</label>
            <input placeholder="" name="Password" value="@Model?.Password" required></input>
        </div>

        <!-- Role -->
        <div class="form-group">
            <label>Role</label>
            <select name="Role" value="@Model?.Role" asp-items="Html.GetEnumSelectList<RoleType>()" required>
                <option value="">-- Select Role --</option>
            </select>
        </div>
    </div>
    

</div>