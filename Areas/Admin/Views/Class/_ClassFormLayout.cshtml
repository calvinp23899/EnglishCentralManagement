@{
    var ClassStatusEnum = Enum.GetValues(typeof(ClassStatusEnum)).Cast<ClassStatusEnum>();

}
<div class="teacher-form__grid">
    <!-- ClassCode -->
    <div class="form-group">
        <label>Class Code</label>
        <input type="text" placeholder="IELTS-" name="ClassCode" value="@Model?.ClassCode" required />
    </div>

    <!-- StartedDate -->
    <div class="form-group">
        <label>Started Date</label>
        <input 
            type="date" 
            name="StartDate" 
            value="@(Model?.StartDate?.ToString("yyyy-MM-dd"))" 
            required />
    </div>


    <!-- StartedDate -->
    <div class="form-group">
        <label>Ended Date</label>
        <input type="date" name="EndDate" value="@(Model?.EndDate?.ToString("yyyy-MM-dd"))" required />
    </div>

    <!-- Class Size -->
    <div class="form-group">
        <label>StudentCount</label>
        <input type="number" placeholder="1" name="MaxStudents" value="@Model?.MaxStudents" required />
    </div>

    <!-- Status -->
    <div class="form-group">
        <label>Status</label>
        <select name="Status" required>
            <option value="">-- Select Status --</option>

            @foreach (var itemStatus in ClassStatusEnum)
            {
                if (Model?.Status == itemStatus)
                {
                    <option value="@( (int)itemStatus )" selected="selected">
                        @itemStatus
                    </option>
                }
                else
                {
                    <option value="@( (int)itemStatus )">
                        @itemStatus
                    </option>
                }
            }
        </select>
    </div>

    <!-- Note -->
    <div class="form-group">
        <label>Note</label>
        <textarea cols="3" type="text" name="Note" >@Model?.Note</textarea>
    </div>

    <!-- TeacherId -->
    <div class="form-group teacher-select">
        <label>Teacher</label>      
        <div class="select-wrapper">
            <input type="text"
                   id="teacherInput"
                   class="select-input"
                   placeholder="-- Select Teacher --"
                   readonly
                   onclick="toggleTeacherDropdown()" />

            <input type="hidden" name="TeacherId" id="TeacherId" />

            <div id="teacherDropdown" class="select-dropdown">
                <input type="text"
                       id="teacherSearch"
                       class="select-search"
                       placeholder="Search teacher..."
                       onkeyup="filterTeacher()" />

                <ul>
                    @foreach (var t in Model.Teachers)
                    {
                        <li onclick="selectTeacher('@t.FullName', '@t.Id')">
                            @t.FullName
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>

    <!-- CourseId -->
    <div class="form-group course-select">
        <label>Course</label>       
        <div class="select-wrapper">
            <input type="text"
                   id="courseInput"
                   class="select-input"
                   placeholder="-- Select Course --"
                   readonly
                   onclick="toggleCourseDropdown()" />

            <input type="hidden" name="CourseId" id="CourseId" />

            <div id="courseDropdown" class="select-dropdown">
                <input type="text"
                       id="courseSearch"
                       class="select-search"
                       placeholder="Search course..."
                       onkeyup="filterCourse()" />

                <ul>
                    @foreach (var t in Model.Courses)
                    {
                        <li onclick="selectCourse('@t.CourseName', '@t.Id')">
                            @t.CourseName
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>

</div>