@model PagedResult<ClassDto>

<div class="admin-page admin-teacher">

    <!-- TOOLBAR -->
    <div class="admin-page__toolbar">
        <input type="text" placeholder="Search class..." />
        <button class="btn-search">Search</button>
    </div>

    <!-- TABLE -->
    <div class="admin-page__table">
        <table>
            <thead>
                <tr>
                    <th>ClassCode</th>
                    <th>Course</th>
                    <th>StartedDate</th>
                    <th>EndedDate</th>
                    <th>Maximum Student</th>
                    <th>Status</th>
                    <th width="120">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || !Model.Items.Any())
                {
                    <tr>
                        <td colspan="5" style="text-align:center;">
                            No class found
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var classItem in Model.Items)
                    {
                        <tr id="class-row-@classItem.ClassId">
                            <td>@classItem.ClassCode</td>
                            <td>@classItem.ClassCourse</td>
                            <td>@classItem.StartDate</td>
                            <td>@classItem.EndDate</td>
                            <td>@classItem.StudentCount</td>
                            <td>@classItem.Status</td>
                            <td class="actions">
                                <a class="view"
                                   href="@Url.Action("MyClassDetail", "Class", new { area = "Admin", id = classItem.ClassId })">
                                    View
                                </a>
                            </td>
                        </tr>
                    }
                }

            </tbody>

        </table>
    </div>

    <!-- PAGINATION -->
    <div class="admin-page__pagination-wrapper">
        <div class="admin-page__pagination-info">
            Showing <strong>
                @((Model.PageIndex - 1) * Model.PageSize + 1)
                –
                @(Math.Min(Model.PageIndex * Model.PageSize, Model.TotalRecords))
            </strong>
            of
            <strong>@Model.TotalRecords</strong>
            records
        </div>

        <div class="admin-page__pagination">
            <!-- Prev -->
            <button class="btn-prev"
                    onclick="location.href='@Url.Action("Index", new { page = Model.PageIndex - 1 })'"
            @(Model.HasPrevious ? "" : "disabled")>
                ‹ Prev
            </button>

            <!-- Page 1 -->
            <button class="@(Model.PageIndex == 1 ? "active" : "")"
                    onclick="location.href='@Url.Action("Index", new { page = 1 })'">
                1
            </button>

            @{
                int start = Math.Max(2, Model.PageIndex - 2);
                int end = Math.Min(Model.TotalPages - 1, Model.PageIndex + 2);
            }

            <!-- ... trước -->
            @if (start > 2)
            {
                <span class="pagination-dots">...</span>
            }

            <!-- Pages giữa -->
            @for (int i = start; i <= end; i++)
            {
                if (i == Model.PageIndex)
                {
                    <button class="active">@i</button>
                }
                else
                {
                    <button onclick="location.href='@Url.Action("Index", new { page = i })'">
                        @i
                    </button>
                }
            }

            <!-- ... sau -->
            @if (end < Model.TotalPages - 1)
            {
                <span class="pagination-dots">...</span>
            }

            <!-- Page cuối -->
            @if (Model.TotalPages > 1)
            {
                <button class="@(Model.PageIndex == Model.TotalPages ? "active" : "")"
                        onclick="location.href='@Url.Action("Index", new { page = Model.TotalPages })'">
                    @Model.TotalPages
                </button>
            }

            <!-- Next -->
            <button class="btn-next"
                    onclick="location.href='@Url.Action("Index", new { page = Model.PageIndex + 1 })'"
            @(Model.HasNext ? "" : "disabled")>
                Next ›
            </button>
        </div>
    </div>

    <form id="antiForgeryForm" style="display:none;">
        @Html.AntiForgeryToken()
    </form>
</div>
