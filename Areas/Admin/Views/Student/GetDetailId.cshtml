<div class="teacher-form view-only">
    <div class="teacher-form__header">
        <h2>Teacher Information</h2>
    </div>

    <div class="teacher-form__grid">

        <div class="form-group">
            <label>First Name</label>
            <div class="form-value">John</div>
        </div>

        <div class="form-group">
            <label>Last Name</label>
            <div class="form-value">Doe</div>
        </div>

        <div class="form-group">
            <label>Date of Birth</label>
            <div class="form-value">1995-08-12</div>
        </div>

        <div class="form-group">
            <label>Phone Number</label>
            <div class="form-value">0123456789</div>
        </div>

        <div class="form-group">
            <label>Email</label>
            <div class="form-value">teacher@email.com</div>
        </div>

        <div class="form-group">
            <label>Status</label>
            <span class="form-value">Active</span>
        </div>

        <div class="form-group">
            <label>Contract Type</label>
            <div class="form-value">Full-time</div>
        </div>

        <div class="form-group">
            <label>Working Type</label>
            <div class="form-value">Hybrid</div>
        </div>

        <div class="form-group">
            <label>Years of Experience</label>
            <div class="form-value">5 years</div>
        </div>

        <div class="form-group">
            <label>Hourly Rate</label>
            <div class="form-value">$25 / hour</div>
        </div>

        <div class="form-group">
            <label>Salary</label>
            <div class="form-value">$1,200 / month</div>
        </div>

        <div class="form-group">
            <label>Onboarding Date</label>
            <div class="form-value">2024-01-10</div>
        </div>

        <div class="form-group full">
            <label>Address</label>
            <div class="form-value">123 Nguyen Trai, District 5, HCMC</div>
        </div>

        <div class="form-group full">
            <label>Avatar</label>
            <img class="avatar" src="/assets/img/avatar-default.png" />
        </div>

    </div>
</div>
