@model ProfileDto

<div class="admin-profile-page">
    <!-- HEADER -->
    <div class="profile__header">
        <h1>Profile</h1>
    </div>
    <div class="profile-grid">
        <!-- LEFT: BASIC INFO -->
        <div class="profile-card profile-sidebar">
            <div class="avatar">
                <img src="/assets/img/avatar-default.png" alt="Avatar" />
            </div>

            <h3 class="name">@Model.FullName</h3>
            <p class="role">@Model.Title</p>

            <div class="social-links">
                <a href="#">📞 @Model.PhoneNumber </a>
                <a href="#">📍 @Model.Address</a>
            </div>
        </div>

        <!-- RIGHT: DETAIL INFO -->
        <div class="profile-card profile-details">

            <div class="detail-row">
                <span class="label">Email</span>
                <span class="value">@Model.Email</span>
            </div>

            <div class="detail-row">
                <span class="label">Age</span>
                <span class="value">@Model.Age</span>
            </div>
            <div class="detail-row">
                <span class="label">Gender</span>
                <span class="value">@Model.Gender</span>
            </div>
            <div class="detail-row">
                <span class="label">Date Of Birth</span>
                <span class="value">@Model.DateOfBirth</span>
            </div>
            <div class="detail-row">
                <span class="label">Contract</span>
                <span class="value">@Model.ContractType</span>
            </div>
            <div class="detail-row">
                <span class="label">Role</span>
                <span class="value">@Model.Role</span>
            </div>
            <div class="detail-row">
                <span class="label">Resume</span>
                <span class="value">Download</span>
            </div>
            <div class="detail-row">
                <span class="label">Linked</span>
                <span class="value">xxxxxxxxxxxxxx</span>
            </div>
        </div>
    </div>
</div>
